# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# External APIs
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FuelRouteAPI/1.0 (take-home-assessment; contact@example.com)
HTTP_TIMEOUT_SECONDS=10

# Caching (seconds)
GEOCODE_CACHE_TTL=86400
ROUTE_CACHE_TTL=3600

# Vehicle defaults (miles / mpg)
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
MIN_PURCHASE_GALLONS=5
RESERVE_MILES=25

# Station filter distance from route (miles)
STATION_CORRIDOR_MILES=15

# Path to fuel price CSV (relative to project root or absolute)
FUEL_PRICES_CSV=data/fuel-prices.csv
